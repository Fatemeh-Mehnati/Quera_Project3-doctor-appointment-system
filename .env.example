# ==== این متغیرها را در Vercel > Project Settings > Environment Variables وارد کنید ====

# --- Django ---
SECRET_KEY=یک-کلید-تصادفی-طولانی-و-امن-بساز
DEBUG=False
ALLOWED_HOSTS=your-project.vercel.app,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app,https://yourdomain.com

# --- Database (از Neon کپی کن، چیزی شبیه همین: ) ---
# Neon Dashboard > Connection string > حتما نسخه‌ای با sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# --- Google OAuth (از قبل داشتی) ---
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# --- ایمیل برای ارسال کد OTP ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=youraddress@gmail.com

OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
